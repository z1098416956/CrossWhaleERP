<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neton.dao.AccountDao">

    <select id="queryAccountInfoList" resultType="com.neton.res.AccAccountVO">
        select * from acc_account
        where is_deleted = 0
        <if test="params.id != null">
            and id = #{params.id}
        </if>
    </select>

    <select id="queryUserInfoPage" resultType="com.neton.res.UserInfoVO">
        select
            t1.id,
            t1.account_no accountNo,
            t1.account_name name,
            t1.avatar
        from
            acc_account t1
        where is_deleted = 0
        <if test="params.id != null">
            and t1.id = #{params.id}
        </if>
    </select>
</mapper>
