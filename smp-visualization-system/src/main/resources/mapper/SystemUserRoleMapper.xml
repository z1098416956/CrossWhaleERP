<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neton.dao.SystemUserRoleDao">
    <delete id="deleteByUserId">
        delete from system_user_role where user_id = #{userId}
    </delete>


    <select id="getUserRoleInfo" resultType="com.neton.res.SystemRuleVO">
        select
            t2.*
        from
            system_user_role t1
            left join system_role t2 on  t1.role_id = t2.id
        where t1.is_deleted = 0
        and t1.user_id = #{userId}
    </select>
</mapper>
