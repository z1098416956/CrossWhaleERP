<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cross.whale.dao.AccountDao">

    <select id="queryAccountInfoList" resultType="com.cross.whale.res.AccAccountVO">
        select * from acc_account
        where is_deleted = 0
        <if test="params.id != null">
            and id = #{params.id}
        </if>
        <if test="params.accountNo != null and params.accountNo != ''">
            and account_no like concat('%',#{params.accountNo},'%')
        </if>
        <if test="params.name != null and params.name != ''">
            and name like concat('%',#{params.name},'%')
        </if>
        <if test="params.username != null and params.username != ''">
            and account_name like concat('%',#{params.username},'%')
        </if>
        <if test="params.deptIds != null and params.deptIds.size > 0">
            and dept_id in
            <foreach collection=" params.deptIds" item="deptId" open="(" separator="," close=")">
                #{deptId}
            </foreach>
        </if>
        <if test="params.ids != null and params.ids.size > 0">
            and id in
            <foreach collection=" params.ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>

    <select id="queryUserInfoPage" resultType="com.cross.whale.res.UserInfoVO">
        select
            t1.id,
            t1.account_no accountNo,
            t1.account_name name,
            t1.avatar
        from
            acc_account t1
        where is_deleted = 0
        <if test="params.id != null">
            and t1.id = #{params.id}
        </if>
        <if test="params.accountNo != null and params.accountNo != ''">
            and account_no like concat('%',#{params.accountNo},'%')
        </if>
        <if test="params.name != null and params.name != ''">
            and account_name like concat('%',#{params.name},'%')
        </if>
        <if test="params.deptIds != null and params.deptIds.size() > 0">
            and dept_id in
            <foreach collection="params.deptIds" item="deptId" open="(" separator="," close=")">
                #{deptId}
            </foreach>
        </if>
    </select>
</mapper>
